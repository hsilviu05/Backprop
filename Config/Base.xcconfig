// Shared build settings. Per-developer values live in Secrets.xcconfig (git-ignored).
// Copy Secrets.example.xcconfig to Secrets.xcconfig and fill it in.

BACKPROP_BUNDLE_ID = com.example.backprop
BACKPROP_TEAM_ID =
REVENUECAT_API_KEY =

// xcconfig treats "//" as a comment, so URLs use "/$()/" to keep both slashes.
BACKPROP_TERMS_URL = https:/$()/www.apple.com/legal/internet-services/itunes/dev/stdeula/
BACKPROP_PRIVACY_URL =

#include? "Secrets.xcconfig"
