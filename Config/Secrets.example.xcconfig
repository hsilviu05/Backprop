// Copy to Config/Secrets.xcconfig (git-ignored) and fill in your values.

// Your bundle ID, exactly as registered in App Store Connect.
BACKPROP_BUNDLE_ID = com.yourname.backprop

// Apple Developer Team ID (developer.apple.com > Membership).
BACKPROP_TEAM_ID = ABCDE12345

// RevenueCat PUBLIC Apple SDK key (starts with "appl_"). Never put a secret key (sk_...) here.
REVENUECAT_API_KEY = appl_xxxxxxxxxxxxxxxxxxxxxxxx

// Hosted privacy policy. Keep "/$()/" so xcconfig doesn't treat "//" as a comment.
BACKPROP_PRIVACY_URL = https:/$()/yourdomain.com/privacy
